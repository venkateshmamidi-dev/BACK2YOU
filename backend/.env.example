# Back2You Environment Configuration

# Application
SECRET_KEY=back2you-super-secret-production-key-2026

# Supabase Credentials (Optional: Leave empty to run with local SQLite & Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=item-images

# AI / ML Model Settings
SENTENCE_MODEL_NAME=all-MiniLM-L6-v2

# Matching Weights (Image, Text, Location, Time, Category/Attributes)
WEIGHT_IMAGE=0.40
WEIGHT_TEXT=0.30
WEIGHT_LOCATION=0.15
WEIGHT_TIME=0.10
WEIGHT_ATTRIBUTES=0.05
